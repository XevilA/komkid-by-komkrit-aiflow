# ============================================================================
# คมคิด by KOMKRIT — Real Multi-LLM, Google Veo, Google Flow & Omnichannel APIs
# (คัดลอกไฟล์นี้เป็น .env หรือกรอกคีย์ผ่านหน้าหลังบ้าน "ตั้งค่า API Keys & Providers" ได้ทันที)
# ============================================================================

# 1. Google Gemini API (ปลดล็อก Gemini 3.8 Flash / 4 Argon, Nano Banana 2.1, Gemini Omni 1.1 Flash Video & Flow, Gemini 3.8 Flash TTS เสียงไทย)
GEMINI_API_KEY=

# 2. Anthropic Claude API (Claude Sonnet 4 / Opus 4 / 3.7 Sonnet)
ANTHROPIC_API_KEY=

# 3. DeepSeek Official API (DeepSeek-V3 deepseek-chat / DeepSeek-R1 deepseek-reasoner)
DEEPSEEK_API_KEY=

# 4. OpenAI ChatGPT API (GPT-4.1 / GPT-4o / o3-mini + DALL-E 3 + OpenAI TTS)
OPENAI_API_KEY=

# 5. Google Veo 3.1 / 3.0 GA บน Google Cloud Vertex AI Enterprise (ทางเลือกเพิ่มเติม)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_ACCESS_TOKEN=

# 6. เสียงพากย์ ElevenLabs & ส่งจดหมายข่าว Resend Email API (ทางเลือกเพิ่มเติม)
ELEVENLABS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Komkrit <onboarding@resend.dev>
