# ==============================================================================
# คมคิด by KOMKRIT (KOMKID AI Flow) — Coolify / Contabo VPS Environment Template
# Copy these variables into Coolify -> Application -> Environment Variables
# ==============================================================================

NODE_ENV=production
PORT=8080

# --- Admin CMS & AES-256-GCM Security Vault (REQUIRED IN PRODUCTION) ---
# ADMIN_PASSWORD is REQUIRED. There is no built-in default password: without it a serverless host
# refuses admin login, and a VPS prints a random one-time password in the server log at boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_AUTH_SECRET=change-me-64-hex-hmac-secret
VAULT_MASTER_KEY=change-me-64-hex-aes256-master-key

# --- AI Providers (Optional: Can also be configured via Admin UI API Vault) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=

# --- Google Cloud Vertex AI (Optional: For Veo / Imagen Enterprise) ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# --- Networking / limits (optional) ---
# Number of reverse proxies in front of the app (Traefik = 1). Used for the real client address in rate limits.
TRUST_PROXY_HOPS=1
# Max CEO-agent runs per hour (they call paid AI APIs)
AGENT_MAX_RUNS_PER_HOUR=60
# DNS targets shown in the domain checker
# DNS_TARGET_VPS_IP=
# DNS_TARGET_VERCEL_IP=76.76.21.21
# DNS_TARGET_VERCEL_CNAME=cname.vercel-dns.com
